PORT=4000

# One API key per web, sent in the x-api-key header. The key decides which app is calling.
# Each must be at least 32 characters and all three must differ.
API_KEY_BLOG=
API_KEY_CELLPHONES=
API_KEY_JOB_PORTAL=

# Cloudflare R2 (S3-compatible)
STORAGE_REGION=auto
# https://<account-id>.r2.cloudflarestorage.com (no bucket name in the path)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public bucket: holds public/ and temp/public/. Public access (r2.dev or custom domain) enabled.
STORAGE_BUCKET_NAME=
# Private bucket: holds private/ and temp/private/. Must NOT have any public access enabled.
STORAGE_PRIVATE_BUCKET_NAME=
# Public base URL of the public bucket (R2 custom domain or r2.dev URL)
STORAGE_PUBLIC_URL=
